#!/usr/bin/env bash
# bin/doctor - diagnostico de ferramentas, configs, auth e fontes.
set -euo pipefail
DOTFLOW_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFLOW_ROOT
DOTFLOW_VERSION=$(<"$DOTFLOW_ROOT/VERSION")
export DOTFLOW_VERSION

for _lib in log platform registry backup stow fonts shell nvim setup doctor verify capture reminder engine; do
  # shellcheck disable=SC1090
  . "$DOTFLOW_ROOT/lib/${_lib}.sh"
done
unset _lib

ALL=0
ARGS=()
while (($#)); do
  case $1 in
    --all) ALL=1 ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done

engine_parse_args "${ARGS[@]}"
detect_platform

if ((ALL)); then
  mapfile -t TOOLS < <(registry_ids)
else
  mapfile -t TOOLS < <(engine_selected_tools)
fi

rc=0
doctor_run "${TOOLS[@]}" || rc=1
echo
doctor_checks_extra || rc=1
exit $rc
